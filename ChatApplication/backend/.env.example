NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/chat_app
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte hex key used to encrypt integration credentials (Cloudinary, Firebase, TURN) stored in the DB
SETTINGS_ENCRYPTION_KEY=
# Used only by `npm run bootstrap:admin` to create the single Super Admin
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
