NODE_ENV=development
PORT=4000
# Neon Serverless PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte hex key used to encrypt integration credentials (Cloudinary, Firebase, TURN) stored in the DB
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Used only by `npm run bootstrap:admin` to create the single Super Admin
BOOTSTRAP_ADMIN_USERNAME=root
BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!

# Cloudinary Integration (optional - can also be configured by Super Admin via Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
